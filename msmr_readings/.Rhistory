get_my_data("B300957")
str(locus)
names(locus)
locus <- locus %>%
mutate(across(everything(), as.numeric))
summary(locus)
# 删除含缺失值的样本
locus <- na.omit(locus)
#---------------------------
# Cronbach's α
#---------------------------
alpha(locus %>% select(starts_with("loc")))
alpha(locus %>% select(starts_with("cope")))
alpha(locus %>% select(starts_with("anx")))
alpha(locus %>% select(starts_with("dep")))
#---------------------------
#CFA
#---------------------------
cfa_model <- '
#latent variables
locus =~ loc1 + loc2 + loc3 + loc4 + loc5 + loc6
coping =~ cope1 + cope2 + cope3 + cope4 + cope5 + cope6 + cope7 + cope8
anxiety =~ anx1 + anx2 + anx3 + anx4
depression =~ dep1 + dep2 + dep3 + dep4
# correlation
anxiety ~~ depression
'
fit_cfa <- cfa(cfa_model, data = locus, std.lv = TRUE)
summary(fit_cfa, fit.measures = TRUE, standardized = TRUE)
#---------------------------
#SEM
#---------------------------
sem_model <- '
# measurement
locus =~ loc1 + loc2 + loc3 + loc4 + loc5 + loc6
coping =~ cope1 + cope2 + cope3 + cope4 + cope5 + cope6 + cope7 + cope8
anxiety =~ anx1 + anx2 + anx3 + anx4
depression =~ dep1 + dep2 + dep3 + dep4
anxiety ~~ depression
# structural paths
coping ~ a*locus
anxiety ~ b1*coping + c1*locus
depression ~ b2*coping + c2*locus
# mediation (indirect effects)
indirect_anx := a*b1
indirect_dep := a*b2
# total effects
total_anx := c1 + (a*b1)
total_dep := c2 + (a*b2)
'
#SEM（Bootstrap 5000）
fit_sem <- sem(
sem_model,
data = locus,
std.lv = TRUE
)
summary(fit_sem, fit.measures = TRUE, standardized = TRUE, ci = TRUE)
standardizedSolution(fit_sem)
get_my_data("B300957")
gardenpath
View(gardenpath)
