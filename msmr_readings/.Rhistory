gardenpath <- gardenpath %>%
filter(gtype %in% c(1,2,3)) %>%
mutate(
participant = as.factor(participant),
gtype = factor(gtype),
gtype = relevel(gtype, ref = "3"),
Months = as.numeric(months),
age = as.numeric(age),
prevexp = as.factor(prevexp)
)
summary(gardenpath)
summary(gardenpath)
gardenpath |> distinct(participant,age) |> summary()
ggplot(gardenpath, aes(x = Months, y = RSES, color = gtype)) +
stat_summary(fun = mean, geom = "line", linewidth = 1.2) +
stat_summary(fun = mean, geom = "point") +
stat_summary(fun.data = mean_cl_boot, geom = "errorbar", width = 0.5) +
labs(
title = "Self-esteem trajectories by gardening type",
x = "Months",
y = "RSES (Self-esteem)"
) +
theme_minimal()
ggplot(gardenpath, aes(x = Months, y = RSES, color = gtype)) +
stat_summary(fun = mean, geom = "line", linewidth = 1.2) +
stat_summary(fun = mean, geom = "point") +
stat_summary(fun.data = mean_cl_boot, geom = "errorbar") +
labs(
