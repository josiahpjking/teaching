# DATA CLEANING
# Analysis of missing values
## Exclude participants with missing values in all variables
locus_clean <- locus|>
filter(!if_all(2:23, is.na))
## Resulting number of participants
N_part_loc <- nrow(locus_clean)
## Reverse coding (locus4, cope3)
locus_reverse <- locus_clean |>
mutate(
loc4 = abs(loc4 - 6),
cope3 = abs(cope3 - 6)
)
locus_check <- locus_reverse |>
mutate(
total_mean = rowMeans(across(everything()), na.rm = TRUE)
)
# Create table that shows mean of scales by missingness group
analysis_data <- locus_reverse |>
mutate(
missing_group = case_when(
is.na(loc1) & is.na(cope1) ~ "Missing Locus & Cope",
is.na(anx1) & is.na(dep1) ~ "Missing Anxiety & Depression",
TRUE ~ "No Missings"
),
mean_loc  = rowMeans(pick(starts_with("loc")), na.rm = TRUE),
mean_cop  = rowMeans(pick(starts_with("cope")), na.rm = TRUE),
mean_anx  = rowMeans(pick(starts_with("anx")), na.rm = TRUE),
mean_depr = rowMeans(pick(starts_with("dep")), na.rm = TRUE)
)
analysis_data
with(analysis.data, t.test(mean_anx~missing_group))
with(analysis_data, t.test(mean_anx~missing_group))
with(analysis_data, t.test(mean_dep~missing_group))
analysis_data
with(analysis_data, t.test(mean_depr~missing_group))
with(analysis_data, t.test(mean_loc~missing_group))
with(analysis_data, t.test(mean_coping~missing_group))
with(analysis_data, t.test(mean_cop~missing_group))
# DATA EXPLORATION
# Calculate means over all scores
locus_check <- locus_reverse |>
mutate(
total_mean = rowMeans(across(everything()), na.rm = TRUE)
)
# Create table that shows mean of scales by missingness group
analysis_data <- locus_reverse |>
mutate(
missing_group = case_when(
is.na(loc1) & is.na(cope1) ~ "Missing Locus & Cope",
is.na(anx1) & is.na(dep1) ~ "Missing Anxiety & Depression",
TRUE ~ "No Missings"
),
mean_loc  = rowMeans(pick(starts_with("loc")), na.rm = TRUE),
mean_cop  = rowMeans(pick(starts_with("cope")), na.rm = TRUE),
mean_anx  = rowMeans(pick(starts_with("anx")), na.rm = TRUE),
mean_depr = rowMeans(pick(starts_with("dep")), na.rm = TRUE)
)
table_data <- analysis_data |>
group_by(missing_group) |>
summarise(
across(starts_with("mean_"), \(x) mean(x, na.rm = TRUE))
)
ft_missing <- flextable(table_data) |>
set_header_labels(
missing_group = "Missing Group",
mean_loc = "Locus (Mean)",
mean_cop = "Coping (Mean)",
mean_anx = "Anxiety (Mean)",
mean_depr = "Depression (Mean)"
) |>
colformat_double(digits = 2, na_str = "NA") |>
set_formatter(
mean_loc = function(x) ifelse(is.nan(x), "NA", sprintf("%.2f", x)),
mean_cop = function(x) ifelse(is.nan(x), "NA", sprintf("%.2f", x)),
mean_anx = function(x) ifelse(is.nan(x), "NA", sprintf("%.2f", x)),
mean_depr = function(x) ifelse(is.nan(x), "NA", sprintf("%.2f", x))
) |>
autofit() |>
theme_vanilla() |>
set_caption(caption = "Table 1: Mean Scale Scores categorized by Missingness Patterns",
style = "Table Caption")
# Check if range 1-5
lapply(locus_reverse, function(x) table(factor(x, levels = 1:5))) # for every variable, every response category was used
# Check for normality
multi.hist(locus[, -1])
descr_locus <- describe(locus_reverse[, -1]) |>
as.data.frame() |>
flextable()
# Internalizing problems (depression and anxiety)
m.int <- "
depression =~ dep1 + dep2 + dep3 + dep4
anxiety =~ anx1 + anx2 + anx3 + anx4
depression ~~ anxiety"
cfa.int <- cfa(m.int, data = locus_reverse, estimator = "ML", )
fit_int <- fitmeasures(cfa.int)[c("srmr","rmsea","cfi","tli")]
summary(cfa.int, standardized = TRUE) # all above .5
# Omega
anx_dep_data <- locus_reverse[, grepl("^(dep|anx)", names(locus_reverse))]
omega_anx_dep <- omega(anx_dep_data, nfactors = 2)$omega.tot
# Table for CFA results
params_int <- parameterEstimates(cfa.int, standardized = TRUE, ci = TRUE) |>
filter(op == "=~") |>
select(
Item = rhs,
Estimate = est,
SE = se,
CI_lower = ci.lower,
CI_upper = ci.upper,
Std_Loading = std.all
) |>
mutate(
across(c(Estimate, SE, CI_lower, CI_upper, Std_Loading), ~ round(.x, 2))
)
ft_int <- flextable(params_int) |>
colformat_num(digits = 2) |>
autofit()
# Coping
m.cope <- "
coping =~ cope1 + cope2 + cope3 + cope4 + cope5 + cope6 + cope7 + cope8"
cfa.cope <- cfa(m.cope, data = locus_clean, estimator = "ML")
fit_cope <- fitmeasures(cfa.cope)[c("srmr","rmsea","cfi","tli")]
modindices(cfa.cope, sort = TRUE)
m.cope.new <- "
coping =~ cope1 + cope2 + cope3 + cope4 + cope5 + cope6 + cope7 + cope8
cope4 ~~ cope7"
cfa.cope.new <- cfa(m.cope.new, data = locus_clean, estimator = "ML")
fit_cope_new <- fitmeasures(cfa.cope.new)[c("srmr","rmsea","cfi","tli")]
summary(cfa.cope.new, standardized = TRUE, ci = TRUE) # all above .5
# Omega
cope_data <- locus_reverse[, grepl("^(cope)", names(locus_reverse))]
omega_cope <- omega(cope_data, nfactors = 1)$omega.tot
# Table for CFA results
params_cope <- parameterEstimates(cfa.cope.new, standardized = TRUE, ci = TRUE) |>
filter(op == "=~") |>
select(
Item = rhs,
Estimate = est,
SE = se,
CI_lower = ci.lower,
CI_upper = ci.upper,
Std_Loading = std.all
) |>
mutate(
across(c(Estimate, SE, CI_lower, CI_upper, Std_Loading), ~ round(.x, 2))
)
ft_cope <- flextable(params_cope) |>
colformat_num(digits = 2) |>
autofit()
# Locus of control
m.locus <- "
locus =~ loc1 + loc2 + loc3 + loc4 + loc5 + loc6"
cfa.locus <- cfa(m.locus, locus_clean, estimator = "ML")
fit_locus <- summary(cfa.locus, fit.measures = TRUE)
fit_loc <- fitmeasures(cfa.locus)[c("srmr","rmsea","cfi","tli")]
# Omega
locus_data <- locus_reverse[, grepl("^(loc)", names(locus_reverse))]
omega_locus <- omega(locus_data, nfactors = 1)$omega.tot
# Modification indices
modindices(cfa.locus, sort = TRUE)
# New model
m.locus.new <- "
locus =~ loc1 + loc2 + loc3 + loc4 + loc5 + loc6
loc3 ~~ loc4"
cfa.locus.new <- cfa(m.locus.new, locus_clean, estimator = "MLR")
summary(cfa.locus.new, standardized = TRUE) # all above .6
fit_loc_new <- fitmeasures(cfa.locus.new)[c("srmr","rmsea","cfi","tli")]
# Table for CFA results
params_locus <- parameterEstimates(cfa.locus.new, standardized = TRUE, ci = TRUE) |>
filter(op == "=~") |>
select(
Item = rhs,
Estimate = est,
SE = se,
CI_lower = ci.lower,
CI_upper = ci.upper,
Std_Loading = std.all
) |>
mutate(
across(c(Estimate, SE, CI_lower, CI_upper, Std_Loading), ~ round(.x, 2))
)
ft_locus <- flextable(params_locus) |>
colformat_num(digits = 2) |>
autofit()
# Full model
m.full <- "
# Measurement part
depression =~ dep1 + dep2 + dep3 + dep4
anxiety =~ anx1 + anx2 + anx3 + anx4
coping =~ cope1 + cope2 + cope3 + cope4 + cope5 + cope6 + cope7 + cope8
locus =~ loc1 + loc2 + loc3 + loc4 + loc5 + loc6
# Structural part
depression ~ b1*coping + b2*locus
anxiety ~ c1*coping + c2*locus
coping ~ a*locus
depression ~~ anxiety
cope4 ~~ cope7
loc3 ~~ loc4
# Mediation
indirect_depr := a*b1
indirect_anx := a*c1
direct_depr := b2
direct_anx := c2
total_depr := (a*b1) + b2
total_anx := (a*c1) + c2
"
# Model identification and estimation
sem.full <- sem(m.full, locus_clean, missing = "FIML")
summary(sem.full)
summary(sem.full,stand=T)
summary(cfa.cope.new)
parameterEstimates(cfa.int, standardized = TRUE, ci = TRUE)
parameterEstimates(cfa.int, standardized = TRUE, ci = TRUE)
