get_my_data <- function(exam_num){
tryCatch(
suppressWarnings(load(url(paste0("https://uoepsy.github.io/msmr/2526/misc/",toupper(exam_num),".RData")))),
error=function(e) cat("No Data Found.\n"))
gardenpath <<- gardenpath
locus <<- locus
}
