library(tidyverse)
library(lme4)
library(lmerTest)
library(parameters)
library(effects)
library(ICC)
library(performance)
library(lavaan)
library(semPlot)
library(psych)
#1.Check the structure
head(gardenpath)
str(gardenpath)
#2.Check variable ranges for impossible values
range(gardenpath$RSES, na.rm = TRUE)
range(gardenpath$age, na.rm = TRUE)
table(gardenpath$prevexp)
table(gardenpath$gtype)
table(gardenpath$months)
gp<-gardenpath |>
filter(RSES >= 0 & RSES <= 30) |>
filter(age >= 12 & age <= 25) |>
filter(gtype %in% c(1,2,3)) |>
mutate(gtype = factor(gtype,
levels = c(1,2,3),
labels = c("Paired", "Community", "Solitary")))
#chech how many rows removed
nrow(gardenpath) - nrow(gp)
#confirm clean data
range(gp$RSES)
range(gp$age)
table(gp$gtype)
null_model <- lmer(RSES ~ 1 + (1 | allotment/participant),
data = gp, REML = TRUE)
icc(null_model)
as.data.frame(VarCorr(null_model))
mod_int <-lmer(RSES ~ months * gtype +age + prevexp +
(1 + months | allotment/participant),
data =gp, REML = FALSE)
anova(mod_noint, mod_int)
#Fit the maximal model
mod_max <-lmer(RSES ~ months * gtype +age + prevexp +
(1 + months | allotment/participant),
data = gp,
REML = TRUE)
model_parameters(mod_max, ci_method = "kr", ci_random =FALSE)
summary(mod_max)
sjPlot::plot_model(mod_max,type="int")
emtrends(mod_max)
emtrends(mod_max,var="months")
emtrends(mod_max,var="months",by="gtype")
?emtrends(mod_max,var="months",by="gtype")
emtrends(mod_max,~gtype,var="months")
emtrends(mod_max,~gtype,var="months") |> pairs()
