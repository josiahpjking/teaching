df1a <- df |> mutate(
ss = round(41.3+scale(rnorm(100, .6*h, 10))[,1]*1.9)
)
df2a <- df2 |> mutate(
ss = round(41.3+scale(rnorm(100, .6*h, 10))[,1]*1.9),
ss = ss-33
)
p3 <- ggplot(df1a, aes(x=h,y=ss))+
geom_point(size=5)+
labs(title="EU study",x="Height (cm)")
p4 <- ggplot(df2a, aes(x=h2,y=ss))+
geom_point(size=5)+
labs(title="US study",x="Height (feet)")
p3 + p4
# which is true?
# covariance will be positive, bigger for plot C
# covariance will be negative, bigger for plot D
# covariance will be positive, bigger for plot C
# covariance will be negative, bigger for plot D
