library(tidyverse)
library(patchwork)
df <- tibble(h = round(rnorm(100,162,12),1))
p1 <- ggplot(df,aes(x=h))+
geom_dotplot()+
labs(title="EU study",x="Height (cm)")
df2 <- df |> mutate(
h2 = h/30.48)
p2 <- ggplot(df2,aes(x=h2))+
